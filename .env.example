# ===== Server =====
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ===== Database (PostgreSQL) =====
# Local: postgres://abu:abu@localhost:5432/abu_chat
# Render/Railway: full connection URL
DATABASE_URL=postgres://abu:abu@localhost:5432/abu_chat

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Encryption (for IG access tokens at rest) =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=replace_me_with_a_64_char_hex_string

# ===== Meta / Facebook OAuth =====
# Get from https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# Comma separated; bare minimum for our use case:
META_SCOPES=instagram_basic,instagram_manage_comments,pages_show_list,pages_read_engagement

# ===== Webhook =====
# This is the token YOU choose; Meta will echo it during verification
META_WEBHOOK_VERIFY_TOKEN=choose_any_long_random_string

# ===== Click to'lov tizimi =====
# https://my.click.uz — Merchant kabineti
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ===== Payme to'lov tizimi =====
# https://merchant.payme.uz — Merchant kabineti
PAYME_MERCHANT_ID=
PAYME_KEY=

# ===== Stripe (ixtiyoriy) =====
STRIPE_SECRET_KEY=
